# PostgreSQL Connection URL (Local Development / Test only)
DATABASE_URL="postgresql://postgres:devpassword123@localhost:5432/trinh_ky_online_dev?schema=public"

# Database URL riêng cho Integration Tests (tùy chọn)
TEST_DATABASE_URL="postgresql://postgres:devpassword123@localhost:5432/trinh_ky_online_test?schema=public"

# JWT Secret Key dùng cho Bearer Token
JWT_SECRET="dev-jwt-secret-key-change-in-production-min-32-chars"

# Gateway Shared Secret dùng cho Trusted Reverse Proxy / Gateway
GATEWAY_SHARED_SECRET="internal-gateway-shared-key-for-trusted-proxies"

# Chế độ nhận raw headers chỉ dành cho môi trường phát triển (Mặc định: false)
ALLOW_DEV_MOCK_AUTH="false"

# Cổng khởi chạy Backend API
PORT=4000
