datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. TỔ CHỨC & NGƯỜI DÙNG (Multi-Company & Department)
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN // Admin tập đoàn: quản trị toàn bộ hệ thống
  ADMIN       // Admin phòng ban
  USER        // Nhân viên thông thường
}

model Organization {
  id        String   @id @default(uuid())
  code      String   @unique // Mã công ty (VD: VGR-HQ, VGR-TECH, VGR-LOGISTICS)
  name      String   // Tên công ty thành viên
  parentId  String?  // Id công ty mẹ nếu là phân cấp tập đoàn
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children     Organization[] @relation("OrgHierarchy")
  departments       Department[]
  users             User[]
  documents         Document[]
  templates         FormTemplate[]
  workflowTemplates WorkflowTemplate[]
  delegationPolicies DelegationPolicy[]
  artifacts         DocumentArtifact[]
  certificates      DigitalCertificate[]

  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  code           String       // Mã phòng ban (VD: IT, HR, ACCT)
  name           String       // Tên phòng ban
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  documents      Document[]
  delegationPolicies DelegationPolicy[]

  @@unique([organizationId, code])
  @@map("departments")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  positionTitle  String?      // Chức danh (Trưởng phòng, Kế toán trưởng, ...)
  role           UserRole     @default(USER)
  organizationId String?
  departmentId   String?
  signatureUrl   String?      // Ảnh chữ ký cá nhân mặc định
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])

  createdTemplates                FormTemplate[]
  createdTemplateVersions         FormTemplateVersion[]
  createdWorkflowTemplates        WorkflowTemplate[]
  createdWorkflowTemplateVersions WorkflowTemplateVersion[]
  createdDocuments                Document[]          @relation("DocumentCreator")
  assignedSteps                   StepAssignee[]
  signatures                      SignatureEvent[]
  comments                        DocumentComment[]
  auditLogs                       AuditLog[]
  decisionHistories               StepDecisionHistory[] @relation("DecisionActor")
  delegatedDecisionsAsDelegator   StepDecisionHistory[] @relation("DecisionDelegator")
  delegationsAsDelegator          DelegationPolicy[]    @relation("DelegationsAsDelegator")
  delegationsAsDelegatee          DelegationPolicy[]    @relation("DelegationsAsDelegatee")
  delegationsCreated              DelegationPolicy[]    @relation("DelegationCreator")
  delegationsRevoked              DelegationPolicy[]    @relation("DelegationRevoker")
  reassignmentsAsOld              StepReassignmentHistory[] @relation("ReassignmentOldUser")
  reassignmentsAsNew              StepReassignmentHistory[] @relation("ReassignmentNewUser")
  reassignmentsAsActor            StepReassignmentHistory[] @relation("ReassignmentActor")
  notifications                   Notification[]
  requestedArtifacts              DocumentArtifact[]        @relation("ArtifactRequester")
  certificates                    DigitalCertificate[]

  @@map("users")
}

// -------------------------------------------------------------
// 2. BIỂU MẪU ĐỘNG (Dynamic Form & Block Layout - TopCV style)
// -------------------------------------------------------------

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model FormTemplate {
  id                   String         @id @default(uuid())
  organizationId       String?        // null: Mẫu dùng chung toàn hệ thống (SUPER_ADMIN)
  code                 String         @unique // VD: TAM_UNG, NGHI_PHEP
  title                String         // VD: Giấy đề nghị tạm ứng
  description          String?
  category             String         @default("Hành chính - Nhân sự")
  status               TemplateStatus @default(DRAFT)
  currentVersion       Int            @default(1)
  
  // JSON chứa danh sách field nhập liệu: id, key, label, type, required, options, validation, order...
  fields               Json
  // JSON chứa danh sách các Layout Block hiển thị tài liệu/PDF: header, text, grid, table, signature...
  layoutBlocks         Json
  // JSON cấu hình các bước duyệt mặc định của biểu mẫu (Backward compatibility)
  defaultWorkflowSteps Json?
  workflowTemplateId   String?

  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization         Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy            User              @relation(fields: [createdById], references: [id])
  workflowTemplate     WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  versions             FormTemplateVersion[]
  documents            Document[]
  delegationPolicies   DelegationPolicy[]

  @@map("form_templates")
}

model FormTemplateVersion {
  id                        String         @id @default(uuid())
  templateId                String
  versionNumber             Int
  title                     String
  description               String?
  fields                    Json
  layoutBlocks              Json
  defaultWorkflowSteps      Json?
  workflowTemplateVersionId String?
  changeSummary             String?
  status                    TemplateStatus @default(PUBLISHED)
  createdById               String
  createdAt                 DateTime       @default(now())

  template                  FormTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdByUser             User                     @relation(fields: [createdById], references: [id])
  workflowTemplateVersion   WorkflowTemplateVersion? @relation(fields: [workflowTemplateVersionId], references: [id], onDelete: SetNull)
  documents                 Document[]

  @@unique([templateId, versionNumber])
  @@map("form_template_versions")
}

// -------------------------------------------------------------
// 2.1. QUY TRÌNH PHÊ DUYỆT ĐỘNG (Workflow Templates & Versions)
// -------------------------------------------------------------

model WorkflowTemplate {
  id                   String                  @id @default(uuid())
  organizationId       String?                 // null: Quy trình dùng chung toàn hệ thống (SUPER_ADMIN)
  code                 String                  @unique // VD: WF_EXPENSE, WF_LEAVE
  title                String                  // VD: Quy trình duyệt chi phí & tạm ứng
  description          String?
  category             String                  @default("Chung")
  status               TemplateStatus          @default(DRAFT)
  currentVersion       Int                     @default(1)

  // JSON lưu cấu hình các bước của quy trình (stepKey, stepName, stepOrder, stepType, completionRule, approverConfig...)
  steps                Json

  createdById          String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization         Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy            User                    @relation(fields: [createdById], references: [id])
  versions             WorkflowTemplateVersion[]
  formTemplates        FormTemplate[]

  @@map("workflow_templates")
}

model WorkflowTemplateVersion {
  id                   String                  @id @default(uuid())
  workflowTemplateId   String
  versionNumber        Int
  title                String
  description          String?
  steps                Json
  changeSummary        String?
  status               TemplateStatus          @default(PUBLISHED)
  createdById          String
  createdAt            DateTime                @default(now())

  workflowTemplate     WorkflowTemplate        @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  createdByUser        User                    @relation(fields: [createdById], references: [id])
  formTemplateVersions FormTemplateVersion[]
  documents            Document[]

  @@unique([workflowTemplateId, versionNumber])
  @@map("workflow_template_versions")
}

// -------------------------------------------------------------
// 3. HỒ SƠ TRÌNH KÝ & PHIÊN BẢN (Documents & Versions)
// -------------------------------------------------------------

enum DocumentStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum UrgencyLevel {
  LOW
  NORMAL
  URGENT
  EMERGENCY
}

model Document {
  id                String         @id @default(uuid())
  documentNumber    String         @unique // Mã số tự tăng: VD: TK-2026-0001
  title             String         // Tiêu đề hồ sơ
  templateId                String
  templateVersionId         String?        // Phiên bản cụ thể của biểu mẫu tại thời điểm tạo
  workflowTemplateVersionId String?        // Phiên bản cụ thể của quy trình duyệt tại thời điểm tạo
  status                    DocumentStatus @default(DRAFT)
  urgency                   UrgencyLevel   @default(NORMAL)
  dueDate                   DateTime?      // Hạn hoàn tất xử lý
  currentStepOrder          Int            @default(1)
  currentVersion            Int            @default(1)
  
  createdById       String
  organizationId    String?
  departmentId      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  template                FormTemplate             @relation(fields: [templateId], references: [id])
  templateVersion         FormTemplateVersion?     @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  workflowTemplateVersion WorkflowTemplateVersion? @relation(fields: [workflowTemplateVersionId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation("DocumentCreator", fields: [createdById], references: [id])
  organization      Organization?        @relation(fields: [organizationId], references: [id])
  department        Department?          @relation(fields: [departmentId], references: [id])

  versions          DocumentVersion[]
  attachments       DocumentAttachment[]
  workflow          ApprovalWorkflow?
  signatureEvents   SignatureEvent[]
  comments          DocumentComment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  artifacts         DocumentArtifact[]

  @@index([status])
  @@index([createdById])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid())
  documentId     String
  versionNumber  Int
  // Dữ liệu người dùng điền theo các fields của template
  formData       Json
  // HTML snapshot tại thời điểm gửi duyệt
  renderedHtml   String?  @db.Text
  // Đường dẫn file PDF đã kết xuất (nếu có)
  pdfUrl         String?
  // Mã SHA-256 băm toàn vẹn nội dung tại phiên bản này
  sha256Hash     String
  changeSummary  String?  // Lý do chỉnh sửa so với version trước
  createdById    String
  createdAt      DateTime @default(now())

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signatures     SignatureEvent[]
  decisionHistories StepDecisionHistory[]
  artifacts      DocumentArtifact[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentAttachment {
  id             String   @id @default(uuid())
  documentId     String
  fileName       String
  fileUrl        String
  fileSize       Int      // Dung lượng file tính bằng bytes
  mimeType       String
  uploadedById   String
  createdAt      DateTime @default(now())

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_attachments")
}

// -------------------------------------------------------------
// 4. QUY TRÌNH DUYỆT & CÁC BƯỚC (Approval Workflow Engine)
// -------------------------------------------------------------

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  REJECTED
  CANCELLED
}

enum StepType {
  SEQUENTIAL
  PARALLEL
}

enum StepCompletionRule {
  ALL_MUST_APPROVE
  ANY_CAN_APPROVE
}

enum StepStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  REJECTED
  REVISION_REQUESTED
  SKIPPED
  CANCELLED
}

enum AssigneeRole {
  APPROVER // Người duyệt: có thẩm quyền Duyệt/Ký hoặc Từ chối
  REVIEWER // Người giám sát: chỉ xem, nhận thông báo và bình luận
}

enum AssigneeDecision {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model ApprovalWorkflow {
  id               String         @id @default(uuid())
  documentId       String         @unique
  status           WorkflowStatus @default(PENDING)
  currentStepOrder Int            @default(1)
  version          Int            @default(0) // Optimistic locking
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  document         Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  steps            ApprovalStep[]

  @@map("approval_workflows")
}

model ApprovalStep {
  id             String             @id @default(uuid())
  workflowId     String
  stepOrder      Int                // Thứ tự bước: 1, 2, 3...
  stepName       String             // Tên bước: VD: "Trưởng phòng duyệt", "Kế toán trưởng"
  stepType       StepType           @default(SEQUENTIAL)
  completionRule StepCompletionRule @default(ALL_MUST_APPROVE)
  status         StepStatus         @default(WAITING)
  version        Int                @default(0) // Optimistic locking
  dueDate          DateTime?          // Hạn xử lý theo SLA (startedAt + dueDays)
  dueDays          Int?               // Số ngày xử lý tối đa theo cấu hình quy trình SLA
  slaWarningSentAt DateTime?          // Thời điểm đã gửi cảnh báo sắp đến hạn
  slaOverdueSentAt DateTime?          // Thời điểm đã gửi cảnh báo quá hạn
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workflow       ApprovalWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignees      StepAssignee[]
  signatures     SignatureEvent[]
  comments       DocumentComment[]
  decisionHistories StepDecisionHistory[]
  reassignments     StepReassignmentHistory[]

  @@unique([workflowId, stepOrder])
  @@map("approval_steps")
}

model StepAssignee {
  id              String           @id @default(uuid())
  stepId          String
  userId          String
  role            AssigneeRole     @default(APPROVER) // APPROVER hoặc REVIEWER
  decision        AssigneeDecision @default(PENDING)
  decisionComment String?
  decidedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  step            ApprovalStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@unique([stepId, userId])
  @@map("step_assignees")
}

model StepDecisionHistory {
  id                  String           @id @default(uuid())
  stepId              String
  documentVersionId   String
  userId              String
  role                AssigneeRole
  decision            AssigneeDecision
  decisionComment     String?
  decidedAt           DateTime         @default(now())
  isDelegated         Boolean          @default(false)
  delegatedFromUserId String?
  delegationPolicyId  String?

  step                ApprovalStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  documentVersion     DocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  user                User             @relation("DecisionActor", fields: [userId], references: [id])
  delegatedFromUser   User?            @relation("DecisionDelegator", fields: [delegatedFromUserId], references: [id])
  delegationPolicy    DelegationPolicy? @relation(fields: [delegationPolicyId], references: [id], onDelete: SetNull)

  @@index([stepId])
  @@index([documentVersionId])
  @@index([delegatedFromUserId])
  @@map("step_decision_histories")
}

// -------------------------------------------------------------
// 5. CHỮ KÝ ĐIỆN TỬ & KIỂM TOÁN (Signature & Audit Trail)
// -------------------------------------------------------------

model SignatureEvent {
  id                String          @id @default(uuid())
  documentId        String
  documentVersionId String
  stepId            String?
  userId            String
  signatureImageUrl String          // Đường dẫn ảnh chữ ký đã chèn
  contentHash       String          // Mã SHA-256 của phiên bản tài liệu lúc ký
  ipAddress         String?
  userAgent         String?
  signedAt          DateTime        @default(now())
  isValid           Boolean         @default(true) // false nếu bị vô hiệu do yêu cầu sửa
  invalidatedReason String?
  invalidatedAt     DateTime?

  document          Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  step              ApprovalStep?   @relation(fields: [stepId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@map("signature_events")
}

model DocumentComment {
  id         String        @id @default(uuid())
  documentId String
  stepId     String?
  userId     String
  content    String
  createdAt  DateTime      @default(now())

  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  step       ApprovalStep? @relation(fields: [stepId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@map("document_comments")
}

model AuditLog {
  id         String   @id @default(uuid())
  documentId String?
  userId     String?
  action     String   // VD: SUBMIT_DOCUMENT, APPROVE_STEP, REQUEST_REVISION...
  details    Json?    // Chi tiết thay đổi hoặc payload
  ipAddress  String?
  createdAt  DateTime @default(now())

  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([action])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 6. LỊCH SỬ CHUYỂN GIAO & THÔNG BÁO (Reassignment & Notification)
// -------------------------------------------------------------

model StepReassignmentHistory {
  id             String       @id @default(uuid())
  stepId         String
  oldUserId      String
  newUserId      String
  reassignedById String
  reason         String
  createdAt      DateTime     @default(now())

  step           ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  oldUser        User         @relation("ReassignmentOldUser", fields: [oldUserId], references: [id])
  newUser        User         @relation("ReassignmentNewUser", fields: [newUserId], references: [id])
  reassignedByUser User       @relation("ReassignmentActor", fields: [reassignedById], references: [id])

  @@index([stepId])
  @@map("step_reassignment_histories")
}

enum NotificationType {
  ASSIGNED_STEP
  REASSIGNED_STEP
  REVISION_REQUESTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  SLA_WARNING
  SLA_OVERDUE
  DELEGATION_ASSIGNED
  DELEGATION_REVOKED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id             String             @id @default(uuid())
  userId         String
  documentId     String?
  type           NotificationType
  title          String
  content        String
  isRead         Boolean            @default(false)
  readAt         DateTime?
  metadata       Json?
  idempotencyKey String?            @unique
  status         NotificationStatus @default(SENT)
  retryCount     Int                @default(0)
  errorMessage   String?
  createdAt      DateTime           @default(now())

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       Document?          @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([documentId])
  @@index([status])
  @@map("notifications")
}

// -------------------------------------------------------------
// 7. CHÍNH SÁCH ỦY QUYỀN DUYỆT (Delegation Policy Engine - Phase 12.1)
// -------------------------------------------------------------

model DelegationPolicy {
  id                String       @id @default(uuid())
  organizationId    String
  delegatorId       String
  delegateeId       String
  startDate         DateTime
  endDate           DateTime
  scopeDepartmentId String?
  scopeTemplateId   String?
  reason            String?
  isActive          Boolean      @default(true)
  createdById       String
  revokedAt         DateTime?
  revokedById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  delegator         User         @relation("DelegationsAsDelegator", fields: [delegatorId], references: [id])
  delegatee         User         @relation("DelegationsAsDelegatee", fields: [delegateeId], references: [id])
  createdBy         User         @relation("DelegationCreator", fields: [createdById], references: [id])
  revokedBy         User?        @relation("DelegationRevoker", fields: [revokedById], references: [id])
  scopeDepartment   Department?  @relation(fields: [scopeDepartmentId], references: [id], onDelete: SetNull)
  scopeTemplate     FormTemplate? @relation(fields: [scopeTemplateId], references: [id], onDelete: SetNull)
  decisionHistories StepDecisionHistory[]

  @@index([organizationId])
  @@index([delegatorId, isActive])
  @@index([delegateeId, isActive])
  @@index([startDate, endDate])
  @@map("delegation_policies")
}

// -------------------------------------------------------------
// 8. TỆP ARTIFACT & KẾT XUẤT PDF (PDF Rendering & Artifact Storage - Phase 13.1)
// -------------------------------------------------------------

enum ArtifactType {
  PREVIEW           // PDF xem trước / bản nháp
  OFFICIAL_UNSIGNED // PDF chính thức chưa ký
}

enum ArtifactStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model DocumentArtifact {
  id                String         @id @default(uuid())
  documentId        String
  documentVersionId String
  organizationId    String
  artifactType      ArtifactType   @default(OFFICIAL_UNSIGNED)
  status            ArtifactStatus @default(PENDING)
  storageKey        String?        // Đường dẫn tương đối / key trong Storage
  mimeType          String         @default("application/pdf")
  sizeBytes         Int?           // Dung lượng byte của file PDF thực tế
  rawPdfHash        String?        // SHA-256 của chính xác các byte PDF được lưu
  formDataHash      String         // SHA-256 canonical của formData tại documentVersion đó
  signedPdfHash     String?        // NULL trong Phase 13.1, dành riêng cho Phase 13.2+ khi ký số thực sự
  requestedById     String
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  document          Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy       User            @relation("ArtifactRequester", fields: [requestedById], references: [id])

  @@unique([documentVersionId, artifactType])
  @@index([documentId, status])
  @@index([organizationId])
  @@index([rawPdfHash])
  @@map("document_artifacts")
}

// -------------------------------------------------------------
// 9. QUẢN LÝ CHỨNG THƯ SỐ X.509 & KHÓA KÝ (Phase 13.2.1)
// -------------------------------------------------------------

enum CertificateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum KeyStorageType {
  DEV_KEYSTORE
  CLOUD_KMS
  REMOTE_SMART_CA
}

model DigitalCertificate {
  id                String            @id @default(uuid())
  organizationId    String
  userId            String?           // Null nếu là chứng thư / con dấu chung của tổ chức
  subjectDn         String            // Ví dụ: "CN=Nguyễn Văn A, O=Tập đoàn VinaGroup, C=VN"
  issuerDn          String            // Ví dụ: "CN=VinaGroup Internal Root CA, O=VinaGroup"
  serialNumber      String            // Serial number theo X.509
  fingerprintSha256 String            // SHA-256 fingerprint của certificate (Hex)
  certificatePem    String            @db.Text // Nội dung chứng thư công khai dạng PEM
  validFrom         DateTime
  validTo           DateTime
  status            CertificateStatus @default(ACTIVE)
  revokedAt         DateTime?
  revokedReason     String?
  keyStorageType    KeyStorageType    @default(DEV_KEYSTORE)
  keyAlias          String            // Định danh khóa trong KMS hoặc alias trong keystore
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, fingerprintSha256])
  @@unique([organizationId, keyAlias])
  @@index([organizationId, status])
  @@index([userId])
  @@index([fingerprintSha256])
  @@map("digital_certificates")
}
